---
// Matchfunding section derived from Figma design
// Uses design tokens and Tailwind utility classes.
// Later this could be powered by real API data.

const { t } = Astro.locals;

// Mock active / past calls (simplified from Figma example)
interface CallCardStat {
    label: string;
    value: string;
}

interface CallCard {
    title: string;
    description: string;
    stats: CallCardStat[]; // supports 2 or more stats depending on the card
    cta: string;
    tag?: string;
    background: string; // temp image url
    finished?: boolean;
}

const calls: CallCard[] = [
    {
        title: "Archicare.\nKeep democratic memory alive. Put it to work.",
        description:
            "Archicare supports feminist and community-led projects that preserve democratic memory and turn archives and lived experience into infrastructures for care, resistance and collective action.",
        stats: [],
        // Figma CTA copy
        cta: "Inscríbete en la convocatoria",
        background: "/images/home/archicare-purple.png",
        tag: "/images/project/09_shelf_ARCHICARE.svg",
    },
    {
        title: "Distributed infrastructures.\nOwn the infrastructure. Share the power.",
        description:
            "Building community-owned, cooperative and federated alternatives to platform dependency",
        stats: [],
        cta: "Ver las campañas de la convocatoria",
        background: "/images/home/distrib-transparent.png",
        tag: "/images/project/10_shelf_DisInfra.svg",
    },
];
---

<section class="bg-secondary w-full text-white">
    <div class="wrapper relative !my-[-32px]">
        <!-- Two top info panels -->
        <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
                <!-- What is Matchfunding -->
                <div
                    class="backdrop-blur-md/0 flex flex-col gap-10 rounded-2xl bg-[rgba(143,124,146,0.4)] p-10"
                >
                    <div class="text-purple flex flex-col gap-4 text-balance">
                        <h2 class="text-purple text-4xl font-bold">
                            {t("pages.home.matchfunding.title")}
                        </h2>
                        <p class="text-base leading-6 text-white">
                            {t("pages.home.matchfunding.description")}
                        </p>
                    </div>
                    <!-- <div class="flex flex-wrap gap-4">
                        <a
                            href="/matchfunding"
                            class="group relative flex items-center gap-2 rounded-xl border border-white/40 bg-white/20 px-6 py-4 text-sm font-bold text-white backdrop-blur-md transition hover:bg-white/30"
                        >
                            {t("pages.home.matchfunding.actions.learnMore")}
                        </a>
                        <a
                            href="/convocatorias"
                            class="bg-purple-soft text-content rounded-xl px-6 py-4 text-sm font-bold transition hover:opacity-90"
                        >
                            {t("pages.home.matchfunding.actions.viewCalls")}
                        </a>
                    </div> -->
                </div>
            </div>

            <!-- Calls (cards) -->
            <div class="flex flex-col gap-6 lg:flex-row">
                {
                    calls.map((card) => (
                        <div
                            class="relative flex w-full flex-col justify-between overflow-hidden rounded-xl bg-cover bg-center text-shadow-2xs lg:w-1/2"
                            style={`background-image:url(${card.background});`}
                        >
                            <div class="relative z-10 flex flex-col gap-10 p-10">
                                <div class="flex w-1/2 flex-col gap-4">
                                    <h4 class="text-3xl font-bold">{card.title}</h4>
                                    <p>{card.description}</p>
                                    <div class="flex gap-6">
                                        {card.stats.map((s) => (
                                            <div class="flex flex-col">
                                                <span class="text-sm text-white">{s.label}</span>
                                                <span class="text-2xl font-bold">{s.value}</span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                            <div class="border-xl absolute top-6 right-6 z-20 rounded bg-white px-2 py-1 text-xs font-medium">
                                <img class="h-12" src={card.tag} />
                            </div>
                            <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-r from-black/70 to-black/30" />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
